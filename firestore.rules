rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{document} {
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /itineraries/{document} {
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /preferences/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /checklist/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /chatHistory/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Shared itineraries: role-based access
    match /sharedItineraries/{itineraryId} {
      allow read: if request.auth != null &&
        (resource.data.ownerUid == request.auth.uid ||
         request.auth.uid in resource.data.editorUids ||
         request.auth.uid in resource.data.viewerUids);
      allow write: if request.auth != null &&
        (resource.data.ownerUid == request.auth.uid ||
         request.auth.uid in resource.data.editorUids);
      allow create: if request.auth != null;

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null &&
          resource.data.authorUid == request.auth.uid;
      }
    }

    // Rate limit counters — Cloud Functions write these, users can only read own
    match /rateLimits/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // Only writable by Cloud Functions
    }

    // All other documents: deny by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
